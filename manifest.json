{
  "manifest_version": 3,
  "name": "DSH 标签页自动分组",
  "short_name": "DSH Tab Groups",
  "version": "0.5.0",
  "description": "把浏览器中所有指向 DeepSeek Harness（DSH）Web GUI 的标签页自动收进同一个标签组，并允许 DSH GUI 页面直接查询状态、触发归组与改配置。纯本地运行，不联网、不上报。",
  "minimum_chrome_version": "89",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*",
      "https://*.dsh-market.com/*"
    ]
  },
  "action": {
    "default_title": "DSH 标签页自动分组",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
